# Build output and IDE state -- regenerable, and large.
build/
.dart_tool/
.idea/
*.iml

# Local only: a path to a local natural_block, and what a failed
# golden test leaves behind. This file replaces .gitignore for pub, so these
# have to be named again.
pubspec_overrides.yaml
**/failures/

# The example's platform folders are generated by `flutter create` and are
# not needed to read or run the sample.
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/web/
example/build/
example/.dart_tool/
